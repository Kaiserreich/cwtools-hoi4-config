types = {
	type[resistance_activity] = {
		path = "game/common/resistance_activity"
	}
}

## replace_scope = { root = state this = state }
resistance_activity = {
	## cardinality = 0..1
	available = {
		## cardinality = ~1..inf
		alias_name[trigger] = alias_match_left[trigger]
	}

	## cardinality = 0..1
	weight = {
		## cardinality = 0..1
		enum[base_factor] = variable_field
		## cardinality = 0..inf
		alias_name[modifier_rule] = alias_match_left[modifier_rule]
	}

	## cardinality = 0..1
	max_amount = int
	## cardinality = 0..1
	duration = int

	## cardinality = 0..1
	effect = {
		## cardinality = ~1..inf
		alias_name[effect] = alias_match_left[effect]
	}

	### Modifier applied to the state while the activity is active
	## cardinality = 0..1
	state_modifier = {
		## cardinality = ~1..inf
		alias_name[modifier] = alias_match_left[modifier]
	}

	### If set, shows an alert on the map when the activity triggers
	## cardinality = 0..1
	alert_text = localisation
}
